{
  "version": 2,
  "name": "channelzap",
  "github": {
    "enabled": true,
    "silent": true
  },
  "routes": [
    {
      "src": "/api/v1/(.*)",
      "dest": "https://channelzap-backend.onrender.com/api/v1/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_BASE_URL": "https://channelzap-backend.onrender.com",
    "NEXT_PUBLIC_APP_NAME": "ChannelZap ERP",
    "NEXT_PUBLIC_DOMAIN": "channelzap.com"
  }
}
